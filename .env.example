# Environment Variables Template
# Copy this file to .env and fill in your credentials

# PostgreSQL Configuration
POSTGRES_URI=postgresql://<user>:<password>@<host>:<port>/<dbname>

# Snowflake Configuration
SF_ACCOUNT=<account_identifier>
SF_USER=<username>
SF_PASSWORD=<password>
SF_WAREHOUSE=<warehouse_name>
SF_DATABASE=<database_name>
SF_SCHEMA=<schema_name>

# Oracle Standard Database Configuration
ORACLE_USER=<username>
ORACLE_PASSWORD=<password>
ORACLE_HOST=<host>
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=<service_name>
ORACLE_SCHEMA=SAMPLE_DATASETS

# OCI Autonomous Database (mTLS)
OCI_ADB_USER=<username>
OCI_ADB_PASSWORD=<password>
OCI_ADB_DSN=<dsn>
OCI_ADB_WALLET_DIR=<path_to_wallet>
OCI_ADB_WALLET_PASSWORD=<wallet_password>

# AWS / S3 Configuration
AWS_ACCESS_KEY_ID=<access_key>
AWS_SECRET_ACCESS_KEY=<secret_key>
AWS_DEFAULT_REGION=us-east-1
